#!/usr/bin/env bash
# lab — helper CLI used inside the lab terminal. Talks to the local API.
set -uo pipefail
API="${LAB_API_URL:-http://localhost:10201}"
SC="${LAB_SCENARIO:-}"
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
need_sc() { [ -n "$SC" ] || { echo "no scenario in this terminal (LAB_SCENARIO is empty)"; exit 1; }; }
jqpy() { python3 -c "import sys,json; d=json.load(sys.stdin); $1"; }

case "${1:-help}" in
  check)
    need_sc
    bold "Running checks for $SC ..."
    curl -fsS -X POST "$API/api/scenarios/$SC/check" | jqpy '
for r in d["results"]:
    print(("  \033[32m✔\033[0m " if r["passed"] else "  \033[31m✘\033[0m ") + r["name"])
    if not r["passed"] and r["output"]:
        print("      " + r["output"].replace("\n","\n      ")[:600])
print()
print("\033[1;32mAll checks passed!\033[0m" if d["passed"] else "\033[1;33mNot there yet.\033[0m (attempt %d)" % d["attempts"])
for c in (d.get("concepts") or []):
    print("  • " + c)
' ;;
  hint)
    need_sc
    idx="${2:-}"
    if [ -z "$idx" ]; then
      idx=$(curl -fsS "$API/api/scenarios/$SC" | jqpy 'print(d["state"].get("hints_revealed",0))')
    fi
    curl -fsS -X POST "$API/api/scenarios/$SC/hint?index=$idx" | jqpy '
print("\033[1;33mHint %d/%d:\033[0m %s" % (d["index"]+1, d["total"], d["hint"]))' ;;
  brief)
    need_sc
    curl -fsS "$API/api/scenarios/$SC" | jqpy 'print("\033[1m"+d["title"]+"\033[0m\n"); print(d["brief"])' ;;
  solution)
    need_sc
    curl -fsS "$API/api/scenarios/$SC/solution" | jqpy 'print(d["markdown"])' | ${PAGER:-less -R} ;;
  reset)
    need_sc
    bold "Resetting $SC (cleanup + setup)..."
    curl -fsS -X POST "$API/api/scenarios/$SC/reset" | jqpy 'print("job", d["id"], d["status"])' ;;
  status)
    curl -fsS "$API/api/cluster/status" | jqpy '
print("docker:", "ok" if d["docker"] else "DOWN"); print("cluster:", d["cluster_name"], "exists" if d["exists"] else "absent", "| api:", "ok" if d["api_reachable"] else "unreachable")
for n in d["nodes"]: print("  node", n["name"], "Ready" if n["ready"] else "NotReady", "(cordoned)" if n["unschedulable"] else "")
print("addons:", ", ".join(k for k,v in d["addons"].items() if v) or "none")' ;;
  k9s) exec k9s -n "${LAB_NAMESPACE:-default}" ;;
  *)
    cat <<USAGE
lab — SRE Kube Labs helper
  lab check            run the scenario checks
  lab hint [n]         reveal the next hint (or hint n, 0-based)
  lab brief            print the scenario brief
  lab solution         open the solution (pager)
  lab reset            reload the scenario (cleanup + setup)
  lab status           cluster status
  lab k9s              open k9s in the scenario namespace
USAGE
    ;;
esac
